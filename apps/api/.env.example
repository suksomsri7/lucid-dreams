# apps/api/.env — ตัวอย่าง (ไฟล์จริงไม่เข้า repo · chmod 600 · systemd อ่านผ่าน EnvironmentFile)
# คัดลอก: cp .env.example .env แล้วเติมค่า

# ---- เซิร์ฟเวอร์ ----
PORT=8787
HOST=127.0.0.1
# ไฟล์ SQLite (device token hash · ตัวนับ rate · แคช TTS) — เก็บนอก repo ได้
API_DB_PATH=/var/lib/lucid-api/lucid-api.sqlite
# อยู่หลัง nginx ของเราเอง → เชื่อ x-forwarded-for (ตั้ง 0 ถ้ารันตรง ๆ)
API_TRUST_PROXY=1
# APP-RUN §0.5 S2 — /ai/* 60 ครั้ง/ชม./อุปกรณ์
API_RATE_LIMIT_PER_HOUR=60
# จำนวนอุปกรณ์ที่ออก token ได้ต่อ IP ต่อชั่วโมง (กันสร้างอุปกรณ์ทิ้ง)
API_DEVICE_LIMIT_PER_HOUR=20

# ---- AI (OpenRouter · OpenAI-compatible) ----
# กุญแจของเจ้าของ — ใส่ที่นี่เท่านั้น ห้ามเข้า repo ห้ามขึ้น log
OPENROUTER_API_KEY=
# slug ของ OpenRouter (เปลี่ยนรุ่นได้โดยไม่ต้องแก้โค้ด) — ยืนยัน slug จริงด้วย GET /api/v1/models
AI_MODEL=anthropic/claude-opus-5
AI_MODEL_FALLBACK=anthropic/claude-sonnet-5
AI_TIMEOUT_MS=20000
AI_REFERER=https://lucid.suksomsri.cloud
AI_TITLE=Lucid Dream
# 1 = ยอมให้บูตด้วย mock provider (เครื่องทดสอบเท่านั้น · prod ห้ามตั้ง)
# AI_ALLOW_MOCK=0

# ---- TTS ----
# ยังไม่เลือกผู้ให้บริการ (ดู ledger/wo-notes/L1.5.md §หนี้) · ไม่ตั้ง = /ai/tts ตอบ 501
# TTS_PROVIDER=mock

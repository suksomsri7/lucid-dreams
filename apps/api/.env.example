# apps/api/.env — ตัวอย่าง (ไฟล์จริงไม่เข้า repo · chmod 600 · systemd อ่านผ่าน EnvironmentFile)
# คัดลอก: cp .env.example .env แล้วเติมค่า

# ---- เซิร์ฟเวอร์ ----
PORT=8787
HOST=127.0.0.1
# ไฟล์ SQLite (device token hash · ตัวนับ rate · แคช TTS) — เก็บนอก repo ได้
API_DB_PATH=/var/lib/lucid-api/lucid-api.sqlite
# อยู่หลัง nginx ของเราเอง → เชื่อ x-forwarded-for (ตั้ง 0 ถ้ารันตรง ๆ)
API_TRUST_PROXY=1
# APP-RUN §0.5 S2 — /ai/* 60 ครั้ง/ชม./อุปกรณ์
API_RATE_LIMIT_PER_HOUR=60
# จำนวนอุปกรณ์ที่ออก token ได้ต่อ IP ต่อชั่วโมง (กันสร้างอุปกรณ์ทิ้ง)
API_DEVICE_LIMIT_PER_HOUR=20

# ---- AI (OpenRouter · OpenAI-compatible) ----
# กุญแจของเจ้าของ — ใส่ที่นี่เท่านั้น ห้ามเข้า repo ห้ามขึ้น log
OPENROUTER_API_KEY=
# slug ของ OpenRouter (เปลี่ยนรุ่นได้โดยไม่ต้องแก้โค้ด) — ยืนยัน slug จริงด้วย GET /api/v1/models
AI_MODEL=anthropic/claude-opus-5
AI_MODEL_FALLBACK=anthropic/claude-sonnet-5
AI_TIMEOUT_MS=20000
AI_REFERER=https://lucid.suksomsri.cloud
AI_TITLE=Lucid Dream
# 1 = ยอมให้บูตด้วย mock provider (เครื่องทดสอบเท่านั้น · prod ห้ามตั้ง)
# AI_ALLOW_MOCK=0

# ---- TTS (เสียงกระซิบของลายน้ำ) ----
# มติเจ้าของ 24 ก.ย.: fal.ai → ElevenLabs eleven-v3 (POST https://fal.run/fal-ai/elevenlabs/tts/eleven-v3)
#   fal   = ของจริง (ต้องมี FAL_KEY)
#   mock  = WAV เงียบ สำหรับ QC/dev
#   ไม่ตั้ง = /ai/tts และ /ai/anchor ตอบ 501 NOT_CONFIGURED (ของที่แคชไว้แล้วยังเสิร์ฟได้)
# TTS_PROVIDER=fal
# กุญแจ fal ของเจ้าของ — ใส่ที่นี่เท่านั้น ห้ามเข้า repo ห้ามขึ้น log
FAL_KEY=
# ชื่อเสียงของ ElevenLabs — **เคาะแล้ว 24 ก.ย. ค่ำ: Sarah** (prod ต้องตั้งค่านี้) · ไม่ตั้ง = Sarah
# กระซิบเป็น "You… are… dreaming…" อังกฤษ เสียงเดียว ทุกคน ทุกภาษา UI (มติ v2-C)
#   → เซิร์ฟเวอร์ส่ง lang: 'en' ให้ fal ตายตัว · lang ใน body แค่แยกแถวแคช/ตัวหนังสือบนจอ
TTS_VOICE=Sarah
# ครอบทั้งเรนเดอร์ + ดาวน์โหลดไฟล์จาก CDN ของ fal
TTS_TIMEOUT_MS=30000
# ⚠️ ค่าเรนเดอร์ $0.10 ต่อ 1,000 ตัวอักษร ⇒ ประโยคละ ~0.2 สตางค์ · แคชตลอดชีพใน tts_cache
#    เปลี่ยน TTS_VOICE แล้ว "ของเก่าไม่หาย" — คีย์แคชคนละแถว (ดู ledger/wo-notes/L1.5b.md §หนี้)

# ---- /ai/anchor (ผสมระฆัง + เสียงกระซิบเป็นไฟล์เดียว) ----
# ต้องมี ffmpeg · ไม่ตั้งจะหาที่ /usr/bin/ffmpeg แล้ว /usr/local/bin/ffmpeg · ไม่เจอ = 501 NOT_CONFIGURED
# FFMPEG_PATH=/usr/bin/ffmpeg
# v2-C (มติ 24 ก.ย. ค่ำ): ระฆัง 9.8 วิ จาก engine (volume 0.9) + กระซิบครั้งเดียว atempo=0.85
#   volume 1.1 วางทับที่ 2600 ms → mp3 128k 48 kHz mono ยาว ~9.8 วิ (~160 KB)
#   ตัวเลขทั้งชุดอยู่ในกุญแจแคช `anchor|v2c|…` ⇒ ของ v1 เลิกถูกเสิร์ฟเองโดยไม่ต้องล้าง tts_cache

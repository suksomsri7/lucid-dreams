{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "r1-internal": {
      "distribution": "internal",
      "ios": { "simulator": false, "resourceClass": "m-medium" },
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://dreaming.suksomsri.cloud" },
      "channel": "r1"
    },
    "testflight": {
      "distribution": "store",
      "ios": { "resourceClass": "m-medium" },
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://dreaming.suksomsri.cloud" },
      "channel": "testflight"
    }
  },
  "submit": { "testflight": { "ios": { "ascAppId": "<ASC_APP_ID>", "appleTeamId": "<TEAM_ID>" } } }
}

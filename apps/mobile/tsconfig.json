{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",

    "noEmit": false,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./.tsbuild",
    "rootDir": ".",
    "tsBuildInfoFile": "./.tsbuild/.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [{ "path": "../../packages/data" }, { "path": "../../packages/engine" }],
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "app.config.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", ".expo", ".tsbuild", "ios", "android"]
}

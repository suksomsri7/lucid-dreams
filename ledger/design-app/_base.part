<meta name="viewport" content="width=device-width">
<style>
/* ══ โทเคนสี Lucid Dreams v2 — ธีมขาว สะอาด จานเดียวทั้งชุด ═══════════════
   เวที #f5f6f8 · การ์ด/พื้นแอป #ffffff · พื้นรอง #f3f4f7
   ตัวอักษร #111318 / #5b6170 / #9aa0ad · เส้น #e7e9ee
   accent (ม่วงฝัน) #6b5cff + พื้นจาง #efedff
   REM/รู้ตัว (เขียวมินต์เข้ม) #0e9f7a + พื้นจาง #e6f7f1 · danger #d9483b + พื้นจาง #fdecea
   จอกลางคืน (ภาพ 05 เท่านั้น) มืดอัตโนมัติ #0b0f1a
   ห้ามเพิ่มสีอื่น · ไม่มีเงาหนัก · ไม่มีไล่สี                                 */
:root{
  --stage:#f5f6f8; --sf:#ffffff; --sf2:#f3f4f7; --sf3:#e9ebf0;
  --ink:#111318; --ink2:#5b6170; --mut:#9aa0ad; --line:#e7e9ee;
  --acc:#6b5cff; --acc-bg:#efedff;
  --rem:#0e9f7a; --rem-bg:#e6f7f1;
  --dg:#d9483b; --dg-bg:#fdecea;
  --night:#0b0f1a;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-font-smoothing:antialiased}
body{font-family:'Noto Sans Thai','Sarabun',system-ui,-apple-system,sans-serif;color:var(--ink);
  background:var(--stage);font-size:14px;line-height:1.45}
.wrap{padding:26px;display:flex;flex-direction:column;gap:26px;align-items:flex-start}
.cap{font-size:12.5px;font-weight:700;color:#3b4150;margin:0 0 9px 3px}
.cap span{font-weight:400;color:#7d8494}
.rowf{display:flex;gap:22px;align-items:flex-start}

/* ── กรอบ iPhone 390×844 ─────────────────────────────────────────────── */
.frame.m{width:390px;height:844px;background:var(--sf);border:1px solid #d9dce3;border-radius:46px;
  overflow:hidden;display:flex;flex-direction:column;position:relative;flex:none}
.frame.m.night{background:var(--night);color:#f2f4f8}
.sbar{height:54px;display:flex;align-items:flex-end;justify-content:space-between;padding:0 30px 8px;
  font-size:14px;font-weight:600;flex:none;position:relative}
.sbar .isl{position:absolute;left:50%;top:11px;width:120px;height:35px;margin-left:-60px;background:#000;border-radius:20px}
.sbar .r{font-size:12px}
.nav{height:48px;display:flex;align-items:center;gap:10px;padding:0 20px;flex:none}
.nav .t{font-size:17px;font-weight:700;letter-spacing:-.01em}
.nav .lk{font-size:15px;color:var(--acc);font-weight:500}
.mpg{flex:1;min-height:0;padding:6px 20px 16px;display:flex;flex-direction:column;gap:12px;overflow:hidden}
.mpg.c{align-items:center;justify-content:center;text-align:center}
.tabbar{height:82px;flex:none;border-top:1px solid var(--line);display:flex;justify-content:space-around;padding:10px 20px 0;background:var(--sf)}
.tb{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:10.5px;color:var(--mut);width:80px}
.tb.on{color:var(--acc);font-weight:600}
.tb svg.i{width:24px;height:24px}
.home{position:absolute;bottom:8px;left:50%;width:134px;height:5px;margin-left:-67px;border-radius:3px;background:#111;opacity:.75}
.night .home{background:#fff;opacity:.6}

/* ── กรอบ Apple Watch 45mm (198×242) — นาฬิกาเป็นจอมืดเสมอ ────────────── */
.frame.w{width:198px;height:242px;background:#000;color:#f2f4f8;border:1px solid #2a2f3a;border-radius:48px;overflow:hidden;
  display:flex;flex-direction:column;position:relative;flex:none;padding:14px 14px 12px}
.frame.w .wt{font-size:11px;color:#aab2c5;display:flex;justify-content:space-between;align-items:center}
.frame.w .wt b{color:#a99cff;font-size:11px}
.frame.w .wbig{font-size:34px;font-weight:700;letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:1.05}
.frame.w .wsub{font-size:11px;color:#8a92a6}
.frame.w .wbtn{height:38px;border-radius:19px;display:flex;align-items:center;justify-content:center;gap:6px;font-size:13px;font-weight:600;background:#222b41;color:#f2f4f8}
.frame.w .wbtn.dg{background:rgba(255,107,107,.18);color:#ff6b6b}
.frame.w .wbtn.acc{background:rgba(157,140,255,.2);color:#a99cff}

/* ── ไอคอน ────────────────────────────────────────────────────────────── */
svg.i{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}
svg.i.sm{width:14px;height:14px;stroke-width:1.9}
svg.i.xs{width:12px;height:12px;stroke-width:2}
svg.i.lg{width:22px;height:22px}
svg.i.xl{width:28px;height:28px;stroke-width:1.5}

/* ── ตัวอักษร ─────────────────────────────────────────────────────────── */
h1.big{font-size:28px;font-weight:700;letter-spacing:-.02em;line-height:1.2}
.h2{font-size:15px;font-weight:700}
.lbl{font-size:11.5px;color:var(--mut);letter-spacing:.02em}
.sub{font-size:12.5px;color:var(--ink2)}
.mu{color:var(--mut)}
.num{font-variant-numeric:tabular-nums}
.sp{flex:1}

/* ── การ์ด / แถว ──────────────────────────────────────────────────────── */
.card{background:var(--sf);border:1px solid var(--line);border-radius:18px;padding:16px}
.card.p0{padding:0}
.card.soft{background:var(--sf2);border-color:transparent}
.card.acc{background:var(--acc-bg);border-color:transparent}
.ch{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.ch .h2{flex:1}
.li{display:flex;align-items:center;gap:12px;min-height:50px;padding:0 16px;border-bottom:1px solid var(--line)}
.li:last-child{border-bottom:0}
.li .ti{flex:1;min-width:0}
.li .ti b{display:block;font-size:14px;font-weight:600}
.li .ti .sub{margin-top:1px}
.li .val{font-size:14px;color:var(--ink2)}
.li .cv{color:var(--mut)}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}

/* ── ปุ่ม ─────────────────────────────────────────────────────────────── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:50px;padding:0 18px;border-radius:16px;
  font-size:15.5px;font-weight:600;background:var(--sf2);color:var(--ink);border:1px solid transparent;white-space:nowrap}
.btn.pri{background:var(--ink);color:#fff}
.btn.acc{background:var(--acc);color:#fff}
.btn.gh{background:transparent;border-color:var(--line)}
.btn.dg{background:var(--dg-bg);color:var(--dg)}
.btn.sm{height:34px;padding:0 12px;font-size:13px;border-radius:10px}
.btn.blk{width:100%}
.btn.big{height:60px;border-radius:30px;font-size:17px}

/* ── สวิตช์ / chip / แถบ ───────────────────────────────────────────────── */
.sw{width:50px;height:30px;border-radius:15px;background:var(--sf3);position:relative;flex:none}
.sw::after{content:"";position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:12px;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.15)}
.sw.on{background:var(--rem)}
.sw.on::after{left:23px}
.chip{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;border-radius:17px;border:1px solid var(--line);
  font-size:13px;color:var(--ink);background:var(--sf);white-space:nowrap}
.chip.on{background:var(--ink);border-color:var(--ink);color:#fff;font-weight:600}
.chip.acc{background:var(--acc-bg);border-color:transparent;color:var(--acc);font-weight:600}
.chip.rem{background:var(--rem-bg);border-color:transparent;color:var(--rem);font-weight:600}
.chip.dg{background:var(--dg-bg);border-color:transparent;color:var(--dg);font-weight:600}
.chip.sm{height:26px;padding:0 10px;font-size:12px}
.seg{display:flex;background:var(--sf2);border-radius:12px;padding:3px}
.seg div{flex:1;text-align:center;height:34px;line-height:34px;border-radius:9px;font-size:13px;color:var(--ink2)}
.seg div.on{background:var(--sf);color:var(--ink);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.08)}
.bar{height:6px;border-radius:3px;background:var(--sf3);overflow:hidden}
.bar i{display:block;height:100%;background:var(--acc);border-radius:3px}
.bar.rem i{background:var(--rem)}
.pill{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 12px;border-radius:15px;background:var(--sf2);font-size:12.5px;color:var(--ink2)}
.pill .dot{width:8px;height:8px;border-radius:4px;background:var(--rem)}
.pill .dot.off{background:var(--mut)}
.pill .dot.dg{background:var(--dg)}

/* ── บทสนทนา (ที่ปรึกษา) ──────────────────────────────────────────────── */
.chat{display:flex;flex-direction:column;gap:10px;flex:1;min-height:0}
.bub{max-width:300px;padding:11px 14px;border-radius:18px;font-size:14.5px;line-height:1.5}
.bub.ai{background:var(--sf2);color:var(--ink);align-self:flex-start;border-bottom-left-radius:6px}
.bub.me{background:var(--acc);color:#fff;align-self:flex-end;border-bottom-right-radius:6px}
.bub.me.voice{display:flex;align-items:center;gap:8px}
.bub .mt{display:block;font-size:11px;color:var(--mut);margin-top:4px}
.ai-hd{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--mut)}
.ai-hd .av{width:22px;height:22px;border-radius:11px;background:var(--acc-bg);display:flex;align-items:center;justify-content:center;color:var(--acc)}
.opts{display:flex;flex-wrap:wrap;gap:8px;align-self:flex-start;max-width:320px}
.composer{height:54px;border:1px solid var(--line);border-radius:27px;display:flex;align-items:center;gap:10px;padding:0 8px 0 18px;background:var(--sf);flex:none}
.composer .ph{flex:1;font-size:14.5px;color:var(--mut)}
.composer .ic{width:40px;height:40px;border-radius:20px;display:flex;align-items:center;justify-content:center;background:var(--sf2);color:var(--ink)}
.composer .ic.acc{background:var(--acc);color:#fff}

/* ── การ์ดแผนความฝัน ──────────────────────────────────────────────────── */
.plan{border:1px solid var(--line);border-radius:22px;overflow:hidden;background:var(--sf)}
.plan .ph{padding:18px 18px 12px;display:flex;align-items:center;gap:12px}
.plan .ph .em{font-size:36px;line-height:1}
.plan .ph b{font-size:18px;display:block}
.plan .pr{display:flex;align-items:center;gap:12px;padding:12px 18px;border-top:1px solid var(--line);font-size:14px}
.plan .pr .k{color:var(--mut);width:84px;flex:none;font-size:12.5px}
.plan .pr .v{flex:1;min-width:0}

/* ── สไลเดอร์ / ตัวเลข 0–10 แบบชิป ────────────────────────────────────── */
.slider{height:4px;border-radius:2px;background:var(--sf3);position:relative;margin:14px 0}
.slider i{position:absolute;left:0;top:0;height:100%;background:var(--acc);border-radius:2px}
.slider b{position:absolute;top:-11px;width:26px;height:26px;border-radius:13px;background:#fff;margin-left:-13px;box-shadow:0 1px 4px rgba(0,0,0,.2)}
.scale{display:flex;gap:4px}
.scale div{flex:1;height:34px;border-radius:9px;background:var(--sf2);display:flex;align-items:center;justify-content:center;font-size:12.5px;color:var(--ink2);font-variant-numeric:tabular-nums}
.scale div.on{background:var(--ink);color:#fff;font-weight:600}

/* ── ไทม์ไลน์คืน ─────────────────────────────────────────────────────── */
.band{position:relative;height:28px;border-radius:8px;background:var(--sf2);overflow:hidden}
.band i{position:absolute;top:0;height:100%}
.band i.guard{background:var(--sf3)}
.band i.watch{background:var(--acc-bg)}
.band i.rem{background:var(--rem-bg)}
.band i.cue{width:3px;background:var(--acc)}
.band i.wake{width:3px;background:var(--dg)}
.band2{position:relative;height:6px;margin-top:4px;border-radius:3px;background:transparent}
.band2 i{position:absolute;top:0;height:100%;border-radius:3px;background:var(--rem)}
.tl{display:flex;justify-content:space-between;font-size:10.5px;color:var(--mut);margin-top:4px}
.ev{display:flex;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13.5px}
.ev:last-child{border-bottom:0}
.ev .t{width:44px;flex:none;color:var(--mut);font-variant-numeric:tabular-nums;font-size:12.5px;padding-top:1px}
.ev .d{flex:1;min-width:0}
.ev .d .sub{margin-top:1px}
.hyp{display:flex;align-items:flex-end;gap:3px;height:56px}
.hyp i{flex:1;display:block;border-radius:2px;background:var(--acc-bg)}
.hyp i.on{background:var(--acc)}
.hyp i.ctl{background:var(--sf3)}
.wave{display:flex;align-items:center;gap:3px;height:36px}
.wave i{width:3px;border-radius:2px;background:var(--acc);display:block;opacity:.8}

/* ── ล็อกสกรีน (สว่าง) + การแจ้งเตือน ─────────────────────────────────── */
.lock{position:absolute;inset:0;background:linear-gradient(180deg,#eef0f6,#f8f9fb 60%);display:flex;flex-direction:column;align-items:center;padding-top:70px;gap:4px;color:var(--ink)}
.lock .tm{font-size:78px;font-weight:600;letter-spacing:-.04em;line-height:1}
.lock .dt{font-size:18px;color:var(--ink2)}
.notif{background:rgba(255,255,255,.85);border:1px solid var(--line);border-radius:22px;padding:12px 14px;width:350px;backdrop-filter:blur(20px);color:var(--ink)}
.notif .nh{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink2)}
.notif .nh .app{width:20px;height:20px;border-radius:6px;background:var(--acc)}
.notif b{display:block;font-size:14px;margin-top:4px}
.notif p{font-size:13px;color:var(--ink2);margin-top:1px}

/* ── จอกลางคืน (มืดอัตโนมัติ) ─────────────────────────────────────────── */
.night .card{background:#131a2b;border-color:rgba(255,255,255,.09);color:#f2f4f8}
.night .sub,.night .li .val{color:#aab2c5}
.night .mu,.night .lbl{color:#6b7488}
.night .btn{background:#1a2235;color:#f2f4f8}
.night .btn.dg{background:rgba(255,107,107,.16);color:#ff6b6b}
.night .chip{background:transparent;border-color:rgba(255,255,255,.16);color:#aab2c5}
.night .chip.rem{background:rgba(94,230,192,.14);color:#5ee6c0;border-color:transparent}
.orb{width:200px;height:200px;border-radius:50%;margin:0 auto;position:relative;
  background:radial-gradient(circle at 50% 45%,rgba(94,230,192,.45),rgba(94,230,192,.1) 55%,transparent 72%)}
.orb .c{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}
.orb .c b{font-size:40px;font-weight:700;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.orb .c span{font-size:12px;color:#aab2c5}

/* ── กล่องอธิบายข้างภาพ ───────────────────────────────────────────────── */
.note{max-width:330px;font-size:12.5px;color:#3b4150;background:#fff;border:1px dashed #c6cad4;border-radius:12px;padding:12px 14px;line-height:1.55}
.note b{color:#111318}
.note ol,.note ul{padding-left:18px;margin-top:4px}
</style>
<svg width="0" height="0" style="position:absolute">
 <symbol id="i-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></symbol>
 <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></symbol>
 <symbol id="i-chart" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 14l4-4 4 3 5-6"/></symbol>
 <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></symbol>
 <symbol id="i-cv" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></symbol>
 <symbol id="i-back" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></symbol>
 <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></symbol>
 <symbol id="i-x" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></symbol>
 <symbol id="i-play" viewBox="0 0 24 24"><path d="M6 4l14 8-14 8z"/></symbol>
 <symbol id="i-pause" viewBox="0 0 24 24"><path d="M7 4h4v16H7zM13 4h4v16h-4z"/></symbol>
 <symbol id="i-mic" viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 17v5M8 22h8"/></symbol>
 <symbol id="i-send" viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></symbol>
 <symbol id="i-watch" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="3"/><path d="M9 6V3h6v3M9 18v3h6v-3"/></symbol>
 <symbol id="i-phones" viewBox="0 0 24 24"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></symbol>
 <symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></symbol>
 <symbol id="i-wave" viewBox="0 0 24 24"><path d="M2 12h3l3-8 4 16 4-12 2 4h4"/></symbol>
 <symbol id="i-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></symbol>
 <symbol id="i-hand" viewBox="0 0 24 24"><path d="M18 11V6a2 2 0 0 0-4 0v5M14 10V4a2 2 0 0 0-4 0v6M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2a8 8 0 0 1-6.4-3.2L2.7 15a2 2 0 0 1 3.3-2.3L6 14"/></symbol>
 <symbol id="i-vol" viewBox="0 0 24 24"><path d="M11 5L6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></symbol>
 <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
 <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
 <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></symbol>
 <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></symbol>
 <symbol id="i-spark" viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></symbol>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Not managed by @bacons/apple-targets: this file is copied as-is, so the background
  modes and HealthKit strings below are the source of truth for the watch app.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Dreaming</string>
	<key>CFBundleName</key>
	<string>LucidWatch</string>
	<!-- Thai and English are equal (DESIGN §2 rule 7). The strings themselves live in
	     Localizable.xcstrings next to this file; this key makes the pair explicit in the
	     built bundle the same way apps/mobile/app.config.ts does for the phone. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>th</string>
	</array>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>app.dreaming.ios</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<!-- keeps the HKWorkoutSession alive all night -->
		<string>workout-processing</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>Dreaming reads your heart rate while you sleep so it can tell when you are dreaming and only whisper then.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Dreaming saves the mindfulness session it runs on your watch while you sleep.</string>
	<key>NSMotionUsageDescription</key>
	<string>Dreaming measures how much your wrist moves, which helps tell dreaming sleep from waking.</string>
</dict>
</plist>
